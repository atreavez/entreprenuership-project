# Example only. Configure real HTTPS hostname, certificates, security headers and API service separately.
assettrust.example.org {
    encode zstd gzip
    # HSTS only on live HTTPS hosts after validating certificate and all subdomains.
    header Strict-Transport-Security "max-age=31536000"
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "no-referrer"
    header -Server
    # Basemap tiles are public and licensed. DO NOT route private parcel data here.
    handle /maps/* {
        reverse_proxy 127.0.0.1:8081
    }
    # Keep sensitive geospatial and document endpoints authenticated, with no-store.
    handle /api/* {
        header Cache-Control "no-store"
        reverse_proxy 127.0.0.1:4000
    }
    handle {
        root * /srv/assettrust/web
        try_files {path} /index.html
        file_server
    }
}
