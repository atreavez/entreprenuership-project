DATABASE_URL=postgres://assettrust:assettrust_dev_password@localhost:5432/assettrust
JWT_SECRET=replace_with_at_least_32_random_characters_before_use
PORT=4000
WEB_ORIGIN=http://localhost:5173
UPLOAD_DIR=./private-uploads
NODE_ENV=development

# Generate with: openssl rand -hex 32 (keep separate from JWT_SECRET).
# Required to enroll or verify TOTP MFA. Store in a secret manager in production.
MFA_ENCRYPTION_KEY=replace_with_64_hex_characters

# Document vault authenticated encryption: generate each hex key with `openssl rand -hex 32`.
# JSON must use a key ID, not a sensitive human-readable label. Never commit actual keys.
DOCUMENT_ACTIVE_KEY_ID=v1
DOCUMENT_ENCRYPTION_KEYS={"v1":"replace_with_a_real_64_hex_character_secret"}

# v0.9 local, same-origin basemap. Demo grid is not geographical cartography.
VITE_SELF_HOSTED_MAP_ENABLED=false
VITE_LOCAL_MAP_STYLE_PATH=/maps/style.json
ASSETTRUST_MBTILES_PATH=./data/maps/uganda-demo.mbtiles
ASSETTRUST_MAP_ATTRIBUTION=Illustrative locally generated grid - NOT geographic or cadastral data
ASSETTRUST_TILE_PORT=8081
ASSETTRUST_TILE_HOST=127.0.0.1

# v0.10 map provenance: keep false for the synthetic CLI test grid.
# Production Compose mapping service requires an imported manifest + REAL_GEOGRAPHY dataset.
ASSETTRUST_MAP_REQUIRE_MANIFEST=false
ASSETTRUST_MAP_PRODUCTION_DATA=false

# v0.12: E2E tests refuse writes without matching disposable-instance markers.
# ONLY on a disposable development/test API (NEVER in production):
# ASSETTRUST_E2E_TARGET_ID=unique-job-marker (CI generates automatically; supervised runner replaces per run)
# For the test runner (must exactly match the API marker):
# ASSETTRUST_E2E_EXPECT_TARGET=your-unique-disposable-test-instance-marker
# ASSETTRUST_E2E_ALLOW_MUTATION=YES
