{
  "name": "assettrust-platform",
  "private": true,
  "version": "0.22.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "test": "npm run test --workspace apps/api",
    "smoke:offline": "node tools/offline-domain-smoke.cjs",
    "verify:v03": "node tools/verify-v03.cjs",
    "test:e2e:local": "node tools/e2e-smoke.mjs",
    "verify:v04": "node tools/verify-v04.cjs",
    "verify:architecture": "node tools/verify-v04-architecture.cjs",
    "verify:v05": "node --test tools/tests-v05/*.test.cjs",
    "test:e2e:identity": "node tools/e2e-identity-v05.mjs",
    "verify:syntax": "node tools/verify-v05-syntax.cjs",
    "verify:v06": "node tools/verify-v06.cjs",
    "trust:operator": "node -r dotenv/config tools/appoint-platform-reviewer.mjs dotenv_config_path=.env",
    "verify:v07": "node tools/verify-v07.cjs",
    "verify:v08": "node --test tools/tests-v08/*.test.cjs && tsc --noEmit --strict --target es2022 --module commonjs apps/api/src/contexts/geospatial/domain/parcel-boundary.ts apps/api/src/contexts/geospatial/application/parcel-usecases.ts",
    "test:e2e:geo": "node tools/e2e-geo-v08.mjs",
    "test:e2e:overlaps": "node tools/e2e-overlap-v10.mjs",
    "storage:migrate:v07": "node -r dotenv/config tools/migrate-document-storage-v07.mjs dotenv_config_path=.env",
    "verify:v09": "node --test tools/tests-v09/*.test.cjs && python3 -m unittest discover -s tests/v09 -p \"test_*.py\" -v",
    "maps:demo": "python3 tools/generate-demo-grid-mbtiles.py",
    "maps:serve": "python3 -m services.tiles.tile_service",
    "verify:v10": "node --test tools/tests-v10/*.test.cjs && python3 -m unittest discover -s tests/v10 -p 'test_*.py' -v",
    "maps:provision": "python3 tools/provision-raster-basemap-v10.py",
    "db:migrate": "node tools/migrations/run.cjs",
    "db:check": "node tools/migrations/run.cjs --check",
    "db:baseline": "node tools/migrations/run.cjs --baseline",
    "verify:v11": "node --test tools/tests-v11/*.test.cjs",
    "verify:v12": "node --test tools/tests-v12/*.test.*",
    "verify:v13": "node --test tools/tests-v13/*.test.*",
    "test:e2e:ci": "node tools/ci-live-integration.mjs",
    "test:e2e:all": "node tools/e2e-smoke.mjs && node tools/e2e-identity-v05.mjs && node tools/e2e-geo-v08.mjs && node tools/e2e-overlap-v10.mjs",
    "preflight:v14": "node tools/preflight-v14.cjs",
    "verify:v14": "node --test tools/tests-v14/*.test.*",
    "verify:v15": "node --test tools/tests-v15/*.test.mjs",
    "verify:v16": "node --test tools/tests-v16/*.test.cjs",
    "release:gate": "node tools/release-gate-v16.cjs",
    "verify:v17": "node --test tools/tests-v17/*.test.cjs",
    "release:gate:v17": "node tools/release-gate-v17.cjs",
    "verify:v18": "node --test tools/tests-v18/*.test.cjs",
    "verify:v19": "node --test tools/tests-v19/*.test.cjs",
    "verify:v20": "node --test tools/tests-v20/*.test.cjs",
    "verify:v21": "node --test tools/tests-v21/*.test.cjs",
    "test:pg:parcel-auth:v21": "node tools/e2e-pg-review-v21.mjs",
    "verify:v22": "node --test tools/tests-v22/*.test.cjs",
    "test:pg:trust-session:v22": "node tools/e2e-pg-trust-session-v22.mjs"
  },
  "engines": {
    "node": ">=22.12"
  }
}
